# Database (local dev / managed production)
DATABASE_URL="postgresql://sidesa:sidesa_password@localhost:5432/sidesa_db"

# Auth (for production, set NEXTAUTH_URL to your https domain)
NEXTAUTH_SECRET="generate-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# App Config
NEXT_PUBLIC_APP_NAME="SIDESA"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_DESA_NAME="Desa Sukamaju"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="5242880"

# Local React + Express stack
API_PORT="3001"
WEB_ORIGIN="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:3001"
VITE_DEV_USER_ID=""
VITE_DEV_USER_ROLE="SUPER_ADMIN"

# Docker deployment (optional for docker-compose)
POSTGRES_DB="sidesa_db"
POSTGRES_USER="sidesa"
POSTGRES_PASSWORD="sidesa_password"
BACKUP_RETENTION_DAYS="7"
